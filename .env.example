# ==============================================================================
# NASA Shorts Generator - Configuration
# ==============================================================================

# NASA API Configuration
# Official NASA Image & Video Library (images-api.nasa.gov) does not require a key.
# For other NASA endpoints (api.nasa.gov), provide a key or use DEMO_KEY.
NASA_API_KEY="DEMO_KEY"

# Pexels API Configuration (Stock videos & photos in 9:16 portrait)
# Get your free key at: https://www.pexels.com/api/
PEXELS_API_KEY=""

# Default Media Provider ("auto", "nasa", or "pexels")
MEDIA_PROVIDER="auto"

# LLM API Configuration (Choose Groq, Gemini, or OpenAI)
# Default LLM Provider ("auto", "groq", "gemini", or "openai")
LLM_PROVIDER="auto"

# Groq API Key (https://console.groq.com/keys) - Ultra-fast LPU inference (Llama 3.3)
GROQ_API_KEY=""
# Recommended production model: llama-3.3-70b-versatile
GROQ_MODEL="llama-3.3-70b-versatile"

# Gemini API Key (https://aistudio.google.com/):
GEMINI_API_KEY=""

# OpenAI API Key (https://platform.openai.com/):
OPENAI_API_KEY=""

# Custom LLM API Base URL (optional, e.g. for proxy or local models)
LLM_API_BASE_URL=""

# Custom System Prompt File (optional, default: system_prompt.txt, not tracked in git)
# See system_prompt.txt.example for the template schema
SYSTEM_PROMPT_FILE="system_prompt.txt"

# TTS Configuration
# Options: "edge" (free Microsoft Neural TTS, recommended), "openai", "gemini"
TTS_PROVIDER="edge"
TTS_API_KEY=""

# Default Voice:
# Spanish options: "es-ES-AlvaroNeural", "es-MX-JorgeNeural", "es-ES-ElviraNeural"
# English options: "en-US-ChristopherNeural", "en-US-GuyNeural", "en-US-JennyNeural"
TTS_VOICE="es-ES-AlvaroNeural"

# Video Settings
# Video Format Preset ("vertical" [9:16], "horizontal" [16:9], "square" [1:1], or custom "WIDTHxHEIGHT")
VIDEO_FORMAT="vertical"
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# Video Quality: Constant Rate Factor (16 = ultra crisp, 18 = visually lossless master, 23 = standard)
VIDEO_CRF=18
# FFmpeg Preset ("fast", "medium", "slow" for maximum efficiency)
VIDEO_PRESET="fast"
# Target video bitrate ceiling (12000k recommended for TikTok/Shorts 1080p)
VIDEO_BITRATE="12000k"

# Audio & Music Settings
# Background music volume (0.0 to 1.0, default: 0.22 / 22%)
MUSIC_VOLUME=0.22
# Sound effects volume (0.0 to 1.0, default: 0.35)
SFX_VOLUME=0.35

# Subtitle Position & Color Settings
# Subtitle bottom margin in pixels (default: 540 for vertical Shorts Safe Zone)
SUBTITLE_MARGIN_BOTTOM=540
# Subtitle highlight color: "random", "yellow", "cyan", "green", "orange", "pink", "amber", or ASS hex ("&H0000FFFF&")
SUBTITLE_HIGHLIGHT_COLOR="random"

# Style Variety & Randomization
# Enable full style randomization per video (transitions, colors, music, SFX)
RANDOM_STYLE=false
# Shuffle background music if multiple audio tracks exist in assets/music/
SHUFFLE_MUSIC=true
# Default transition between scenes: "fade", "dissolve", "wipeleft", "slideleft", "smoothleft", "random", or "none"
TRANSITION_TYPE="fade"

# Viral Hook Styles for TikTok & Shorts Retention
# Options: "auto" (balanced), "paradox", "threat", "mystery", "secret", "random"
HOOK_STYLE="auto"
